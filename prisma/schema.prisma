generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String
  name           String
  role           String         @default("STUDENT") 
  availabilities Availability[]
  bookingsHost   Booking[]      @relation("HostBookings")
  bookingsGuest  Booking[]      @relation("GuestBookings")
}

model Availability {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRecurring  Boolean   @default(true)
  dayOfWeek    Int?
  specificDate String?
  startTime    String
  endTime      String
  capacity     Int       @default(1)
  bookings     Booking[]
}

model Booking {
  id              String       @id @default(cuid())
  hostId          String
  guestId         String
  availabilityId  String
  host            User         @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)
  guest           User         @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Cascade)
  availability    Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  date            String
  startTime       String
  endTime         String
  status          String       @default("PENDING") 
  category        String
  topic           String
  currentProgress String
  expectedOutcome String
  attachmentUrl   String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  feedback        Feedback?
}

model Feedback {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  summary     String
  actionItems String
  goals       String
  createdAt   DateTime @default(now())
}